{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bmhair",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {"directory": "./public"},
  "vars": {
    "BM_INDEXABLE": "false",
    "BM_COMMERCE_ENABLED": "false"
  }
}
